EDUSCAN_DATABASE_URL=sqlite:///./eduscan.db
EDUSCAN_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
EDUSCAN_SESSION_DAYS=7
EDUSCAN_SECURE_COOKIES=false
EDUSCAN_OFFLINE_SIGNING_KEY=replace-with-a-long-random-secret-before-deployment
EDUSCAN_OFFLINE_PRIVATE_KEY_DER=generate-with-python-m-app.generate_offline_key
EDUSCAN_UPLOAD_DIR=uploads
EDUSCAN_AUTO_CREATE_SCHEMA=true
